# ══════════════════════════════════════════════════════
#  Faction Dashboard — environment configuration
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────
APP_NAME="Faction Dashboard"
APP_ENV=production
APP_KEY=base64:PLACEHOLDER         # generated automatically on first boot
APP_DEBUG=false
APP_URL=http://localhost           # change to your domain (https://...)

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU

APP_PORT=80                        # host port exposed by Docker (default 80)

# ── Database ──────────────────────────────────────────
# Option A – SQLite (default, no extra setup needed)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Option B – MySQL (uncomment + edit, and enable the mysql block in docker-compose.yml)
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=faction
# DB_USERNAME=faction
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=rootsecret      # only needed by the mysql docker service

# ── Session / Cache ───────────────────────────────────
# File driver works before the DB exists (used during install wizard).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

# ── Logging ───────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Discord Bot ───────────────────────────────────────
# Create a Discord application at https://discord.com/developers/applications
# and add a Bot to it. All four values are required.
DISCORD_CLIENT_ID=           # OAuth2 → Client ID
DISCORD_CLIENT_SECRET=       # OAuth2 → Client Secret
DISCORD_BOT_TOKEN=           # Bot → Token (keep secret!)
DISCORD_GUILD_ID=            # Your server's ID (right-click server → Copy Server ID)

# Optional – notifications will be skipped if left blank
DISCORD_ANNOUNCEMENT_CHANNEL_ID=   # channel where announcements are posted
DISCORD_REPORTS_CHANNEL_ID=        # channel where new report embeds are posted
DISCORD_APPLICATIONS_CHANNEL_ID=   # channel where new join requests are posted
DISCORD_MEMBER_ROLE_ID=            # role ID that counts as a verified member

# ── Mail (optional – log driver writes to storage/logs) ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
